{
  "name": "apuestasdota-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:libre": "node scripts/free-port.mjs 3000 && next dev",
    "lib:puerto": "node scripts/free-port.mjs 3000",
    "build": "next build",
    "start": "next start",
    "qa:serve": "next start -p 3001",
    "qa": "node --env-file-if-exists=.env.local scripts/qa/check.mjs",
    "qa:probes": "node --env-file-if-exists=.env.local scripts/qa/probes.mjs",
    "qa:seed": "node --env-file-if-exists=.env.local scripts/qa/seed.mjs",
    "qa:cleanup": "node --env-file-if-exists=.env.local scripts/qa/seed.mjs --cleanup",
    "qa:flows": "node --env-file-if-exists=.env.local scripts/qa/flows.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
